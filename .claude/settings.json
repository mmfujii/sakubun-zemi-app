{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm --filter @sakubun-zemi/api db:generate)",
      "Bash(pnpm --filter @sakubun-zemi/api exec prisma migrate dev:*)",
      "Bash(docker compose up -d db)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Bash(pnpm --filter @sakubun-zemi/api exec prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(pnpm --filter @sakubun-zemi/infra exec cdk destroy:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.mjs\""
          }
        ]
      }
    ]
  }
}
