{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "ANTHROPIC_API_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_PRICE_ID",
    "STRIPE_COUPON_ID",
    "STRIPE_WEBHOOK_SECRET",
    "QUOTA_ENABLED",
    "LIGHT_MONTHLY_LIMIT",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "API_BASE_PATH",
    "NEXT_PUBLIC_API_URL",
    "API_URL",
    "WEB_APP_URL",
    "CORS_ORIGIN",
    "CLOUD_VISION_API_KEY",
    "GEMINI_API_KEY",
    "GEMINI_OCR_MODEL",
    "DOCAI_PROJECT",
    "DOCAI_PROCESSOR_ID",
    "DOCAI_LOCATION",
    "GCP_SERVICE_ACCOUNT_JSON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
