generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id // Supabase auth user id (UUID) — JWTから取得してupsert
  displayName String?
  // お子さま情報（1ユーザー1件。V1の child_profiles を Profile に統合）
  childName    String?
  grade        Int? // 小学N年生
  targetSchool String?
  createdAt   DateTime @default(now())

  submissions  Submission[]
  subscription Subscription?
}

model Prompt {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id        String   @id @default(uuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id])
  promptId  String?
  prompt    Prompt?  @relation(fields: [promptId], references: [id])
  theme     String
  rawText   String
  status    String   @default("completed") // pending | completed | error
  createdAt DateTime @default(now())

  feedback Feedback?
}

model Feedback {
  id           String     @id @default(uuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  overallScore Int
  result       Json // { scores, child, parent, grammarNotes, kanjiNotes }
  createdAt    DateTime   @default(now())
}

model Subscription {
  userId               String    @id
  user                 Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // free | light
  freeLimit            Int       @default(1) // 無料プランの生涯上限
  monthlyLimit         Int       @default(0) // ライトプランの月上限
  ticketBalance        Int       @default(0) // 追加チケット残数
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Inquiry {
  id        String   @id @default(uuid())
  userId    String? // 送信者(ログインユーザー)。任意
  email     String
  subject   String
  message   String
  status    String   @default("open") // open | resolved
  createdAt DateTime @default(now())
}

model FailureLog {
  id          String   @id @default(uuid())
  userId      String? // 失敗したユーザー(任意)
  eventType   String // ocr_failed | grading_failed
  errorCode   String // 正規化コードのみ(生メッセージは保存しない)
  inputMethod String? // photo | keyboard 等
  createdAt   DateTime @default(now())
}
